{
  "name": "rspack-windows-zero-byte-output-repro",
  "version": "0.0.0",
  "private": true,
  "description": "Reproduce and diagnose zero-byte Rspack outputs under high Windows write fan-out",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "generate": "node ./scripts/generate-input.mjs",
    "reproduce:quick": "node ./scripts/run.mjs --mode default --attempts 1 --count 256 --bytes 1024",
    "reproduce": "node ./scripts/run.mjs --mode default --attempts 5 --count 13500 --bytes 8192",
    "reproduce:instrumented": "node ./scripts/run.mjs --mode instrumented --attempts 5 --count 13500 --bytes 8192",
    "control:sync": "node ./scripts/run.mjs --mode sync --attempts 5 --count 13500 --bytes 8192"
  },
  "devDependencies": {
    "@rspack/cli": "1.7.11",
    "@rspack/core": "1.7.11"
  }
}
